# Normalize all text files to LF on commit and checkout.
# This aligns git with Prettier's endOfLine: "lf" setting and
# prevents CRLF/LF false-positives on Windows.
* text=auto eol=lf

# Treat binary files explicitly so git never tries to convert them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
